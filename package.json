{
  "name": "spicetify-updater",
  "version": "1.0.0",
  "private": true,
  "description": "Install and update the Spicetify CLI and Marketplace from a desktop app",
  "author": "Spicetify Updater",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "serve": "node server.js --open",
    "dist": "electron-builder --win portable --x64"
  },
  "engines": {
    "node": ">=18"
  },
  "build": {
    "appId": "app.spicetify.updater",
    "productName": "Spicetify Updater",
    "artifactName": "Spicetify-Updater-${version}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "lib/**/*",
      "public/**/*",
      "server.js",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "Spicetify-Updater-${version}.exe"
    }
  },
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0"
  }
}
